<Window x:Class="ScarClipScheduler.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScarClipScheduler" Height="960" Width="1560"
        MinHeight="800" MinWidth="1180" WindowStartupLocation="CenterScreen"
        Background="#0B1020" Foreground="#F1F5FF"
        FontFamily="Segoe UI" FontSize="13"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="AppBg" Color="#0B1020"/>
        <SolidColorBrush x:Key="PanelBg" Color="#121A2D"/>
        <SolidColorBrush x:Key="InputBg" Color="#202B49"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#293653"/>
        <SolidColorBrush x:Key="Muted" Color="#9AA8C4"/>
        <SolidColorBrush x:Key="Accent" Color="#8056E8"/>
        <SolidColorBrush x:Key="AccentHover" Color="#956FF3"/>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#202B49"/>
            <Setter Property="Foreground" Value="#F1F5FF"/>
            <Setter Property="BorderBrush" Value="#344363"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="13,8"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Background" Value="#2B385A"/>
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="#6D5B9B"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#8056E8"/>
            <Setter Property="BorderBrush" Value="#926CF0"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#44243A"/>
            <Setter Property="BorderBrush" Value="#713B58"/>
            <Setter Property="Foreground" Value="#FDA4AF"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#202B49"/>
            <Setter Property="Foreground" Value="#F1F5FF"/>
            <Setter Property="BorderBrush" Value="#344363"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,7"/>
            <Setter Property="CaretBrush" Value="#B9A0FF"/>
            <Setter Property="SelectionBrush" Value="#6544A8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#202B49"/>
            <Setter Property="Foreground" Value="#F1F5FF"/>
            <Setter Property="BorderBrush" Value="#344363"/>
            <Setter Property="Padding" Value="7,5"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#DCE5F8"/>
            <Setter Property="Margin" Value="5,3"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="GroupBox">
            <Setter Property="Background" Value="#121A2D"/>
            <Setter Property="Foreground" Value="#C8B8FF"/>
            <Setter Property="BorderBrush" Value="#293653"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0,0,0,9"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#121A2D"/>
            <Setter Property="Foreground" Value="#EAF0FF"/>
            <Setter Property="BorderBrush" Value="#293653"/>
            <Setter Property="RowBackground" Value="#121A2D"/>
            <Setter Property="AlternatingRowBackground" Value="#172239"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#25334F"/>
            <Setter Property="VerticalGridLinesBrush" Value="#25334F"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="RowHeight" Value="36"/>
            <Setter Property="ColumnHeaderHeight" Value="38"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="EnableRowVirtualization" Value="True"/>
            <Setter Property="EnableColumnVirtualization" Value="True"/>
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True"/>
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="SelectionMode" Value="Extended"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#202B49"/>
            <Setter Property="Foreground" Value="#CFD8EE"/>
            <Setter Property="Padding" Value="8,9"/>
            <Setter Property="BorderBrush" Value="#344363"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style x:Key="GridCellText" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0"/>
        </Style>
        <Style x:Key="FileCellText" TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
            <Setter Property="ToolTip" Value="{Binding File}"/>
        </Style>
        <Style x:Key="TitleCellText" TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
            <Setter Property="ToolTip" Value="{Binding Title}"/>
        </Style>
        <Style x:Key="DescriptionCellText" TargetType="TextBlock" BasedOn="{StaticResource GridCellText}">
            <Setter Property="ToolTip" Value="{Binding Description}"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="6,2"/>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#DCE5F8"/>
        </Style>
        <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="76"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#111A2E" BorderBrush="#293653" BorderThickness="1" CornerRadius="11" Padding="15,9" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="38" Height="38" CornerRadius="9" Background="#302153" Margin="0,0,12,0">
                        <TextBlock Text="SC" Foreground="#E9DFFF" FontWeight="Bold" FontSize="15"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel>
                        <TextBlock Text="ScarClipScheduler" FontSize="19" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBlock Text="YouTube Shorts | Facebook Page Reels" Foreground="#9AA8C4" FontSize="11" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>
                <TextBlock x:Name="ConnectionSummary" Grid.Column="1" Text="Connecting to publishing engine..."
                           Foreground="#9AA8C4" VerticalAlignment="Center" Margin="12,0"
                           TextTrimming="CharacterEllipsis" MaxWidth="285"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="About" Click="About_Click" Width="82"/>
                    <Button Content="Quit" Style="{StaticResource DangerButton}" Click="Quit_Click" Width="72"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="218"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#111A2E" BorderBrush="#293653" BorderThickness="1" CornerRadius="11" Padding="12" Margin="0,0,12,0">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <TextBlock Text="WORKSPACE" Foreground="#73829F" FontSize="10" FontWeight="Bold" Margin="8,7,8,9"/>
                        <Button x:Name="NavQueue" Content="Publishing queue" Style="{StaticResource NavButton}" Click="NavQueue_Click" Background="#302153"/>
                        <Button x:Name="NavConnections" Content="Connections" Style="{StaticResource NavButton}" Click="NavConnections_Click"/>
                        <Button x:Name="NavActivity" Content="Activity log" Style="{StaticResource NavButton}" Click="NavActivity_Click"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="5,0,5,5">
                        <Separator Background="#293653" Margin="0,10"/>
                        <TextBlock Text="NATIVE WINDOWS UI" Foreground="#9AA8C4" FontSize="10" FontWeight="Bold"/>
                        <TextBlock Text=".NET 10 WPF | Version 2.0.2" Foreground="#BFAAFF" FontSize="11" Margin="0,4,0,0"/>
                        <TextBlock Text="API worker runs separately." Foreground="#73829F" FontSize="10" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1">
                <!-- Publishing queue -->
                <Grid x:Name="QueuePage" Visibility="Visible">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <GroupBox Grid.Row="0" Header="CLIP SOURCE">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="FolderBox" Grid.Column="0" Margin="0,0,8,0"
                                     ToolTip="Folder with MP4 clips and matching same-basename TXT metadata"/>
                            <Button Grid.Column="1" Content="Browse" Click="BrowseFolder_Click"/>
                            <Button x:Name="ScanButton" Grid.Column="2" Content="Scan clips" Style="{StaticResource PrimaryButton}" Click="Scan_Click" MinWidth="105"/>
                        </Grid>
                    </GroupBox>

                    <GroupBox Grid.Row="1" Header="PUBLISHING SCHEDULE">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="145"/>
                                <ColumnDefinition Width="76"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="22"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="58"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="58"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="First post" VerticalAlignment="Center" Margin="0,0,9,0"/>
                            <DatePicker x:Name="StartDate" Grid.Row="0" Grid.Column="1" Margin="0,0,8,0"
                                        ToolTip="Calendar date for the first post"/>
                            <TextBox x:Name="StartTime" Grid.Row="0" Grid.Column="2" Width="68" Text="05:00"
                                     Margin="0,0,8,0" ToolTip="Local 24-hour time, HH:mm"/>
                            <Button Grid.Row="0" Grid.Column="3" Content="Next 5:00 AM" Click="NextFiveAm_Click"/>
                            <TextBlock Grid.Row="0" Grid.Column="5" Text="Interval" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="IntervalHours" Grid.Row="0" Grid.Column="6" Text="0"
                                     HorizontalContentAlignment="Center" ToolTip="Hours" Margin="0,0,4,0"/>
                            <TextBlock Grid.Row="0" Grid.Column="7" Text="h" VerticalAlignment="Center" Foreground="#9AA8C4" Margin="3,0,8,0"/>
                            <TextBox x:Name="IntervalMinutes" Grid.Row="0" Grid.Column="8" Text="5"
                                     HorizontalContentAlignment="Center" ToolTip="Additional minutes" Margin="0,0,4,0"/>
                            <TextBlock Grid.Row="0" Grid.Column="9" Text="min" VerticalAlignment="Center" Foreground="#9AA8C4" Margin="3,0,0,0"/>
                            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="11" Orientation="Horizontal" Margin="0,9,0,0">
                                <CheckBox x:Name="YoutubeCheck" Content="YouTube Shorts"/>
                                <CheckBox x:Name="FacebookCheck" Content="Facebook Page Reels"/>
                                <Separator Width="1" Height="22" Background="#344363" Margin="10,0"/>
                                <CheckBox x:Name="YoutubeAiCheck" Content="YouTube AI disclosure"/>
                                <CheckBox x:Name="FacebookAiCheck" Content="Facebook AI-generated flag"/>
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="11" Orientation="Horizontal" Margin="0,7,0,0">
                                <TextBlock Text="YouTube category" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox x:Name="CategoryBox" Width="190" SelectedIndex="0">
                                    <ComboBoxItem Content="20 - Gaming" Tag="20"/>
                                    <ComboBoxItem Content="22 - People &amp; Blogs" Tag="22"/>
                                    <ComboBoxItem Content="24 - Entertainment" Tag="24"/>
                                    <ComboBoxItem Content="23 - Comedy" Tag="23"/>
                                    <ComboBoxItem Content="26 - Howto &amp; Style" Tag="26"/>
                                </ComboBox>
                                <CheckBox x:Name="MadeForKidsCheck" Content="Made for kids"/>
                                <CheckBox x:Name="RightsCheck" Content="I own these clips or have permission to repost them."/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                    <WrapPanel Grid.Row="2" Margin="0,0,0,5">
                        <Button x:Name="ScheduleButton" Content="Schedule queue" Style="{StaticResource PrimaryButton}" Click="Schedule_Click"/>
                        <Button x:Name="StopButton" Content="Stop queue" Style="{StaticResource DangerButton}" Click="Stop_Click" IsEnabled="False"/>
                        <Button x:Name="VerifyButton" Content="Check publication" Click="Verify_Click"/>
                        <Button x:Name="ResetFailedButton" Content="Reset failed" Click="ResetFailed_Click"/>
                        <Button Content="Export cleanup report" Click="ExportReport_Click"/>
                    </WrapPanel>

                    <Border Grid.Row="3" Background="#172239" BorderBrush="#293653" BorderThickness="1"
                            CornerRadius="7" Padding="10,6" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="QueueSummary" Foreground="#C7D3EA"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       ToolTip="Counts include every queue item and status."/>
                            <CheckBox x:Name="HideAcceptedCheck" Grid.Column="1" Content="Hide accepted"
                                      IsChecked="True" Checked="HideAccepted_Changed"
                                      Unchecked="HideAccepted_Changed" Margin="10,0,2,0"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="4" Background="#121A2D" BorderBrush="#293653" BorderThickness="1" CornerRadius="9" Padding="8">
                        <DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="DETECTED CLIPS" Foreground="#C8B8FF" FontWeight="Bold" VerticalAlignment="Center" Margin="4,0,12,0"/>
                                <Button Grid.Column="1" Content="Select all" Click="SelectAll_Click"/>
                                <Button Grid.Column="2" Content="Unselect all" Click="UnselectAll_Click"/>
                                <Button Grid.Column="3" Content="Delete from list" Style="{StaticResource DangerButton}" Click="DeleteSelected_Click"/>
                                <TextBlock x:Name="SelectionSummary" Grid.Column="5" Foreground="#9AA8C4" VerticalAlignment="Center" Margin="6,0"/>
                            </Grid>
                            <DataGrid x:Name="ClipGrid" ItemsSource="{Binding Clips}" SelectionChanged="ClipGrid_SelectionChanged"
                                      AutoGenerateColumns="False" CanUserSortColumns="True"
                                      IsReadOnly="True" SelectionMode="Extended" SelectionUnit="FullRow">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="#" Binding="{Binding Number}" Width="42" ElementStyle="{StaticResource GridCellText}"/>
                                    <DataGridTextColumn Header="Queue status" Binding="{Binding QueueStatus}" Width="122" ElementStyle="{StaticResource GridCellText}"/>
                                    <DataGridTextColumn Header="Video file" Binding="{Binding File}" Width="205" ElementStyle="{StaticResource FileCellText}"/>
                                    <DataGridTextColumn Header="Editable title" Binding="{Binding Title}" Width="230" ElementStyle="{StaticResource TitleCellText}"/>
                                    <DataGridTextColumn Header="Description" Binding="{Binding DescriptionPreview}" Width="*" MinWidth="170" ElementStyle="{StaticResource DescriptionCellText}"/>
                                    <DataGridTextColumn Header="Length" Binding="{Binding DurationText}" Width="62" ElementStyle="{StaticResource GridCellText}"/>
                                    <DataGridTextColumn Header="YouTube" Binding="{Binding YoutubeStatus}" Width="82" ElementStyle="{StaticResource GridCellText}"/>
                                    <DataGridTextColumn Header="Facebook" Binding="{Binding FacebookStatus}" Width="86" ElementStyle="{StaticResource GridCellText}"/>
                                    <DataGridTextColumn Header="Scheduled time" Binding="{Binding PublishAtText}" Width="140" ElementStyle="{StaticResource GridCellText}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <GroupBox Grid.Row="5" Header="EDIT SELECTED CLIP" Margin="0,9,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="90"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Title" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <TextBox x:Name="MetadataTitle" Grid.Row="0" Grid.Column="1" MaxLength="100"/>
                            <Button Grid.Row="0" Grid.Column="2" Content="Save metadata" Click="SaveMetadata_Click"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Description" Margin="0,9,8,0"/>
                            <TextBox x:Name="MetadataDescription" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                     VerticalContentAlignment="Top" Margin="0,7,0,0"/>
                        </Grid>
                    </GroupBox>
                </Grid>

                <!-- Connections -->
                <ScrollViewer x:Name="ConnectionsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Account connections" FontSize="20" FontWeight="Bold" Margin="5,4,5,12"/>
                        <GroupBox Header="YOUTUBE CHANNEL">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="YoutubeStatus" Grid.Row="0" Grid.ColumnSpan="4"
                                           Text="Checking YouTube connection..." Foreground="#9AA8C4"
                                           Margin="3,2,3,10" FontWeight="SemiBold"/>
                                <TextBox x:Name="ClientSecretsBox" Grid.Row="1" Grid.Column="0"
                                         ToolTip="Google OAuth Desktop client JSON path" Margin="3"/>
                                <Button Grid.Row="1" Grid.Column="1" Content="Browse JSON"
                                        Click="BrowseClientSecrets_Click"/>
                                <Button x:Name="ConnectYoutubeButton" Grid.Row="1" Grid.Column="2"
                                        Content="Connect YouTube" Style="{StaticResource PrimaryButton}"
                                        Click="ConnectYoutube_Click"/>
                                <Button x:Name="DisconnectYoutubeButton" Grid.Row="1" Grid.Column="3"
                                        Content="Disconnect" Style="{StaticResource DangerButton}"
                                        Click="DisconnectYoutube_Click" Visibility="Collapsed"/>
                            </Grid>
                        </GroupBox>
                        <GroupBox Header="FACEBOOK BUSINESS PORTFOLIO / PAGE REELS">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="FacebookStatus" Grid.Row="0" Grid.ColumnSpan="4"
                                           Text="Checking Facebook connection..." Foreground="#9AA8C4"
                                           Margin="3,2,3,10" FontWeight="SemiBold"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Meta App ID" Foreground="#9AA8C4" Margin="3"/>
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="Meta App Secret" Foreground="#9AA8C4" Margin="3"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="Business Portfolio ID" Foreground="#9AA8C4" Margin="3"/>
                                <TextBox x:Name="MetaAppIdBox" Grid.Row="2" Grid.Column="0" Margin="3"/>
                                <StackPanel Grid.Row="2" Grid.Column="1" VerticalAlignment="Center">
                                    <PasswordBox x:Name="MetaAppSecretBox" Margin="3"
                                                 Background="#202B49" Foreground="#F1F5FF" BorderBrush="#344363" Padding="8"
                                                 ToolTip="Saved locally. Leave blank to keep the current Meta App Secret."/>
                                    <TextBlock Text="Saved locally; leave blank unless changing it."
                                               FontSize="10" Foreground="#9AA8C4" Margin="5,0,3,0"/>
                                </StackPanel>
                                <TextBox x:Name="BusinessIdBox" Grid.Row="2" Grid.Column="2" Margin="3"/>
                                <StackPanel Grid.Row="2" Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="ConnectFacebookButton" Content="Connect Facebook"
                                            Style="{StaticResource PrimaryButton}" Click="ConnectFacebook_Click"/>
                                    <Button x:Name="DisconnectFacebookButton" Content="Disconnect"
                                            Style="{StaticResource DangerButton}" Click="DisconnectFacebook_Click"
                                            Visibility="Collapsed"/>
                                </StackPanel>
                                <GroupBox Grid.Row="3" Grid.ColumnSpan="4" Header="PAGES SELECTED FOR PUBLISHING">
                                    <StackPanel>
                                        <ItemsControl ItemsSource="{Binding Pages}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding Selected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Content="Save selected Pages" HorizontalAlignment="Left" Click="SavePages_Click"/>
                                    </StackPanel>
                                </GroupBox>
                                <TextBlock Grid.Row="4" Grid.ColumnSpan="4"
                                           Text="Disconnect removes saved account tokens from this PC only. It does not cancel videos already accepted and scheduled by the platform."
                                           TextWrapping="Wrap" Foreground="#9AA8C4" Margin="5,4"/>
                            </Grid>
                        </GroupBox>
                        <GroupBox Header="SECURITY &amp; SETUP NOTES">
                            <TextBlock TextWrapping="Wrap" Foreground="#B9C5DA">
                                Google OAuth and Meta Page credentials remain in your Windows user profile.
                                The native UI talks to a local-only background worker. The worker is not exposed
                                to your LAN and requires a per-launch secret token. The Meta redirect URI remains
                                http://localhost:8765/callback.
                            </TextBlock>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>

                <!-- Activity -->
                <Grid x:Name="ActivityPage" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <DockPanel Grid.Row="0" Margin="5,5,5,10">
                        <TextBlock Text="Activity log" FontSize="20" FontWeight="Bold"/>
                        <Button DockPanel.Dock="Right" Content="Clear visible log" Click="ClearLog_Click"/>
                    </DockPanel>
                    <ListBox x:Name="ActivityList" Grid.Row="1" Background="#121A2D" Foreground="#DCE5F8"
                             BorderBrush="#293653" ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#111A2E" CornerRadius="5" Padding="8,3" Margin="0,8,0,0">
            <TextBlock x:Name="FooterStatus" Text="Starting..." Foreground="#9AA8C4" FontSize="11"/>
        </Border>
    </Grid>
</Window>
